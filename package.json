{
  "name": "textunittest",
  "version": "0.3.0",
  "description": "Human-readable Markdown unit testing for generated text files.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "textunittest": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run build && npm test",
    "dev": "tsc --watch"
  },
  "keywords": [
    "markdown",
    "dsl",
    "testing",
    "text",
    "validation",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/textunittest/textunittest.git"
  },
  "bugs": {
    "url": "https://github.com/textunittest/textunittest/issues"
  },
  "homepage": "https://github.com/textunittest/textunittest#readme",
  "dependencies": {
    "commander": "^12.0.0",
    "fastest-levenshtein": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
